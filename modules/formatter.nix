# The formatter that `nix fmt` runs. flake.nix loads this file as a flake-parts
# module, next to modules/machines.nix and modules/checks.nix.
#
# `{ inputs, ... }:` makes this file a function. `inputs` holds every input of
# the flake. The `...` ignores the other arguments that flake-parts passes in.
{ inputs, ... }:

{
  # `nix fmt` runs this program from the repository root. nixfmt-tree is
  # treefmt, a tool that runs formatters over a whole folder, set up to run
  # nixfmt on every .nix file. nixfmt is the official Nix formatter, the same
  # one that nix-tools.nix installs for the editor.
  #
  # `.override { ... }` builds the package again with some of its arguments
  # changed. Here it changes `settings`, which nixfmt-tree passes to treefmt.
  flake.formatter.x86_64-linux = inputs.nixpkgs.legacyPackages.x86_64-linux.nixfmt-tree.override {
    # Files that `nix fmt` leaves alone. hardware-configuration.nix is
    # generated by nixos-generate-config, and its header forbids edits. `**/`
    # matches it in every host folder.
    settings.excludes = [ "**/hardware-configuration.nix" ];
  };
}
