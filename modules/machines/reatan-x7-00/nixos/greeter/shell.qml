pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Controls
import QtQuick.Effects
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.Greetd
import Quickshell.Wayland

// The login screen. greetd starts niri with ../greeter.nix, and niri starts
// this. It looks like the Quickshell bar of the desktop: see-through black
// panels with a gray outline over a blurred wallpaper, and the same clock card.
// Theme.qml is generated by ../greeter.nix from the user's Stylix colors.
ShellRoot {
    id: root

    // The password typed in, kept only until greetd asks for it.
    property string pendingPassword: ""
    // True from pressing Enter until greetd accepts or rejects the password.
    property bool busy: false
    // The last error to show under the password box, or "" for none.
    property string message: ""

    // Starts a login for `user` with `password`. greetd answers through the
    // signals in the Connections below.
    function login(user, password) {
        if (busy || user.length === 0)
            return;

        // A rejected login can leave the old session open. Start fresh.
        if (Greetd.state !== GreetdState.Inactive)
            Greetd.cancelSession();

        pendingPassword = password;
        message = "";
        busy = true;
        Greetd.createSession(user);
    }

    Connections {
        target: Greetd

        // PAM asks a question, usually for the password. Send the typed
        // password once. A second question, such as a fingerprint prompt,
        // gets an empty answer.
        function onAuthMessage(text, error, responseRequired, echoResponse) {
            if (error)
                root.message = text;
            if (responseRequired) {
                Greetd.respond(root.pendingPassword);
                root.pendingPassword = "";
            }
        }

        // The password was right. Start the desktop. `true` quits Quickshell,
        // after which niri quits and greetd starts the session.
        function onReadyToLaunch() {
            Greetd.launch(Theme.sessionCommand, [], true);
        }

        function onAuthFailure(text) {
            root.busy = false;
            root.pendingPassword = "";
            root.message = text.length > 0 ? text : "Wrong password";
        }

        function onError(text) {
            root.busy = false;
            root.pendingPassword = "";
            root.message = text;
        }
    }

    // One window per monitor. Only the first monitor shows the login form.
    // The others show the wallpaper and the clock.
    Variants {
        model: Quickshell.screens

        PanelWindow {
            id: window

            required property ShellScreen modelData
            readonly property bool primary: modelData === Quickshell.screens[0]

            screen: modelData
            color: Theme.panelSolid
            exclusionMode: ExclusionMode.Ignore
            WlrLayershell.layer: WlrLayer.Overlay
            WlrLayershell.namespace: "quickshell-greeter"
            // Keyboard input goes to the form without clicking it first.
            WlrLayershell.keyboardFocus: window.primary
                ? WlrKeyboardFocus.Exclusive
                : WlrKeyboardFocus.None

            anchors {
                top: true
                bottom: true
                left: true
                right: true
            }

            Item {
                id: scene

                anchors.fill: parent

                // A blurred copy of the wallpaper, drawn below the sharp one.
                // Each panel shows the part of it under the panel, which looks
                // like the frosted glass that niri draws on the desktop.
                MultiEffect {
                    id: blurredWallpaper

                    anchors.fill: parent
                    source: wallpaper
                    autoPaddingEnabled: false
                    blurEnabled: true
                    blur: 1.0
                    blurMax: 64
                }

                Image {
                    id: wallpaper

                    anchors.fill: parent
                    source: Theme.wallpaper
                    fillMode: Image.PreserveAspectCrop
                    asynchronous: false
                }

                // The clock card, at the same place and size as on the desktop.
                GlassPanel {
                    id: clockCard

                    x: Math.round(scene.width * Theme.clockLeft)
                    y: Math.round(scene.height * Theme.clockTop)
                    width: Theme.clockWidth
                    height: Theme.clockHeight
                    border: Theme.outlineWidth
                    blurSource: blurredWallpaper

                    SystemClock {
                        id: clock

                        precision: SystemClock.Seconds
                    }

                    Column {
                        anchors.centerIn: parent
                        spacing: 10

                        UiText {
                            anchors.horizontalCenter: parent.horizontalCenter
                            text: Qt.formatDateTime(clock.date, "HH:mm:ss")
                            font.pixelSize: Theme.scaled(50)
                            font.weight: Font.Light
                            font.letterSpacing: 2
                        }

                        UiText {
                            anchors.horizontalCenter: parent.horizontalCenter
                            text: Qt.formatDateTime(clock.date, "ddd, MMM d yyyy")
                            color: Theme.textMuted
                            font.pixelSize: Theme.scaled(17)
                            font.letterSpacing: 1
                        }
                    }
                }

                // The login form, under the clock card.
                GlassPanel {
                    id: loginCard

                    visible: window.primary
                    x: clockCard.x
                    y: clockCard.y + clockCard.height + Theme.gap * 2
                    width: clockCard.width
                    height: form.implicitHeight + Theme.scaled(32)
                    border: Theme.outlineWidth
                    blurSource: blurredWallpaper

                    ColumnLayout {
                        id: form

                        property bool showPassword: false

                        function submit() {
                            root.login(userField.text.trim(), passwordField.text);
                            passwordField.clear();
                        }

                        anchors {
                            fill: parent
                            margins: Theme.scaled(16)
                        }
                        spacing: Theme.gap

                        UiText {
                            text: "Log in"
                            font.pixelSize: Theme.scaled(17)
                            font.weight: Font.DemiBold
                        }

                        LoginField {
                            id: userField

                            Layout.fillWidth: true
                            text: Theme.defaultUser
                            placeholderText: "Username"
                            enabled: !root.busy
                            onAccepted: passwordField.forceActiveFocus()
                        }

                        LoginField {
                            id: passwordField

                            Layout.fillWidth: true
                            placeholderText: "Password"
                            enabled: !root.busy
                            echoMode: form.showPassword ? TextInput.Normal : TextInput.Password
                            onAccepted: form.submit()
                            // Puts the cursor here, so typing can start at once.
                            Component.onCompleted: if (window.primary) forceActiveFocus()
                        }

                        // The error from the last attempt.
                        UiText {
                            Layout.fillWidth: true
                            visible: root.message.length > 0
                            text: root.message
                            color: Theme.destructive
                            wrapMode: Text.Wrap
                            font.pixelSize: Theme.scaled(11)
                        }

                        RowLayout {
                            Layout.fillWidth: true

                            IconButton {
                                glyph: form.showPassword ? "" : ""
                                onClicked: form.showPassword = !form.showPassword
                            }

                            Item {
                                Layout.fillWidth: true
                            }

                            TextButton {
                                primary: true
                                text: root.busy ? "Logging in" : "Log in"
                                enabled: !root.busy && passwordField.text.length > 0
                                onClicked: form.submit()
                            }
                        }
                    }

                    // After a failed attempt, put the cursor back in the
                    // password box.
                    Connections {
                        target: root

                        function onBusyChanged() {
                            if (!root.busy)
                                passwordField.forceActiveFocus();
                        }
                    }
                }

                // Restart and shut down, in the bottom right corner. Each asks
                // for a second click within a few seconds, like the power menu
                // on the desktop, so one stray click does nothing.
                GlassPanel {
                    id: powerPanel

                    property string armedAction: ""

                    function activate(id, command) {
                        if (armedAction !== id) {
                            armedAction = id;
                            disarmTimer.restart();
                            return;
                        }
                        armedAction = "";
                        Quickshell.execDetached(command);
                    }

                    visible: window.primary
                    anchors {
                        right: parent.right
                        bottom: parent.bottom
                        margins: Theme.outerMargin * 2
                    }
                    width: powerRow.implicitWidth + 16
                    height: powerRow.implicitHeight + 16
                    border: Theme.compactOutlineWidth
                    blurSource: blurredWallpaper

                    Timer {
                        id: disarmTimer

                        interval: 3000
                        onTriggered: powerPanel.armedAction = ""
                    }

                    Row {
                        id: powerRow

                        anchors.centerIn: parent
                        spacing: 4

                        IconButton {
                            glyph: ""
                            highlighted: powerPanel.armedAction === "reboot"
                            onClicked: powerPanel.activate("reboot", ["systemctl", "reboot"])
                        }

                        IconButton {
                            glyph: ""
                            highlighted: powerPanel.armedAction === "poweroff"
                            onClicked: powerPanel.activate("poweroff", ["systemctl", "poweroff"])
                        }
                    }

                    // Says what the armed button does, left of the buttons.
                    UiText {
                        anchors {
                            right: parent.left
                            rightMargin: Theme.gap
                            verticalCenter: parent.verticalCenter
                        }
                        visible: powerPanel.armedAction.length > 0
                        text: powerPanel.armedAction === "reboot"
                            ? "Click again to restart"
                            : "Click again to shut down"
                        color: Theme.textMuted
                    }
                }
            }
        }
    }

    // A rounded, see-through black panel with an outline, over the blurred
    // wallpaper. It must sit directly in `scene`, so that its x and y match
    // the place to copy from `blurSource`. Children go inside it.
    component GlassPanel: Item {
        id: glass

        default property alias content: inner.data
        property int border: Theme.outlineWidth
        // The blurred wallpaper to copy from.
        property Item blurSource

        // The part of the blurred wallpaper under this panel.
        ShaderEffectSource {
            id: behind

            anchors.fill: parent
            sourceItem: glass.blurSource
            sourceRect: Qt.rect(glass.x, glass.y, glass.width, glass.height)
            visible: false
        }

        // Cuts the copy to the panel's rounded corners.
        Rectangle {
            id: mask

            anchors.fill: parent
            radius: Theme.radius
            visible: false
            layer.enabled: true
        }

        MultiEffect {
            anchors.fill: parent
            source: behind
            maskEnabled: true
            maskSource: mask
            maskThresholdMin: 0.5
            maskSpreadAtMin: 1.0
        }

        Rectangle {
            anchors.fill: parent
            radius: Theme.radius
            color: Theme.panel
            border.color: Theme.outline
            border.width: glass.border
        }

        Item {
            id: inner

            anchors.fill: parent
        }
    }

    // Text in the bar's font and color.
    component UiText: Text {
        color: Theme.text
        font.family: Theme.fontFamily
        font.pixelSize: Theme.textSize
        renderType: Text.NativeRendering
    }

    // A text box with the same look as the Wi-Fi password box in the bar.
    component LoginField: TextField {
        color: Theme.text
        placeholderTextColor: Theme.textMuted
        selectionColor: Theme.accent
        selectedTextColor: Theme.accentText
        font.family: Theme.fontFamily
        font.pixelSize: Theme.scaled(13)
        leftPadding: 10
        rightPadding: 10
        opacity: enabled ? 1 : 0.6

        background: Rectangle {
            implicitHeight: Theme.scaled(34)
            radius: Theme.radius - 5
            color: Theme.subtleButton
            border.color: parent.activeFocus ? Theme.accent : Theme.outlineTranslucent
            border.width: Theme.compactOutlineWidth
        }
    }

    // A small rounded button with a word on it. `primary` fills it with the
    // accent color. The same as TextButton.qml in the bar.
    component TextButton: Rectangle {
        id: button

        property string text
        property bool primary: false

        signal clicked()

        implicitWidth: buttonLabel.implicitWidth + Theme.scaled(24)
        implicitHeight: Theme.scaled(30)
        radius: Theme.radius - 5
        opacity: enabled ? 1 : 0.4
        color: primary
            ? Theme.accent
            : buttonMouse.containsMouse ? Theme.surfaceHover : Theme.subtleButton

        UiText {
            id: buttonLabel

            anchors.centerIn: parent
            text: button.text
            color: button.primary ? Theme.accentText : Theme.text
            font.pixelSize: Theme.scaled(12)
            font.weight: Font.DemiBold
        }

        MouseArea {
            id: buttonMouse

            anchors.fill: parent
            enabled: button.enabled
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: button.clicked()
        }
    }

    // A square button with a Font Awesome icon. `highlighted` fills it with
    // the accent color.
    component IconButton: Rectangle {
        id: iconButton

        property string glyph
        property bool highlighted: false

        signal clicked()

        implicitWidth: Theme.scaled(30)
        implicitHeight: Theme.scaled(30)
        radius: Theme.radius - 5
        color: highlighted
            ? Theme.accent
            : iconMouse.containsMouse ? Theme.surfaceHover : "transparent"

        UiText {
            anchors.centerIn: parent
            text: iconButton.glyph
            color: iconButton.highlighted ? Theme.accentText : Theme.text
            font.family: Theme.iconFontFamily
            font.pixelSize: Theme.scaled(13)
        }

        MouseArea {
            id: iconMouse

            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: iconButton.clicked()
        }
    }
}
